{
    "name": "@elasticms/admin-ui",
    "version": "0.0.1",
    "description": "ElasticMS admin ui",
    "type": "module",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "development": "./src/index.ts",
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc && vite build",
        "dev": "vite build --watch",
        "format": "prettier --write src/ --config ../prettier.config.js",
        "lint": "eslint src/ --config ../eslint.config.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "elasticms",
        "wysiwyg",
        "tiptap"
    ],
    "license": "LGPL-3.0-or-later",
    "devDependencies": {
        "@eslint/compat": "^1.0.0",
        "@eslint/js": "^9.0.0",
        "@types/node": "^22.0.0",
        "eslint": "^9.0.0",
        "globals": "^15.0.0",
        "prettier": "^3.0.0",
        "typescript": "^5.4.0",
        "typescript-eslint": "^8.0.0",
        "vite": "^6.0.0",
        "vite-plugin-dts": "^4.0.0",
    }
}
